# App Environment
VITE_APP_ENV=development

# Pi 센서 브리지 (기기 데모 촬영) — Android는 eternalbeam.local 이 안 될 수 있음
# URL로 직접: https://device.eternalbeam.com/?demo=device&pi=192.168.0.100
# VITE_PI_HTTP_BASE=http://192.168.0.100:8787
# VITE_PI_HOST=192.168.0.100
# VITE_PI_HOSTS=192.168.0.100,192.168.0.101,eternalbeam.local

# 조정 화면 Luma/FFmpeg 개발 패널 (프로덕션에서만 켜려면 1)
# VITE_SHOW_PIPELINE_DEBUG=1

# 누끼/합성 API (프로덕션 필수). trycloudflare/ngrok 임시 URL은 쓰지 마세요(만료됨).
# 예: https://eternal-beam-video-api.onrender.com
# 비우면 device.eternalbeam.com/api → vercel.json 프록시 사용
# VITE_VIDEO_API_URL=https://eternal-beam-video-api.onrender.com

# 누끼 파이프라인: 기본은 SAM2+ViTMatte(/api/matting/cutout). 문제 생기면 rembg로 즉시 롤백.
# VITE_CUTOUT_PIPELINE=rembg

# 아이들(Idle) 섹션: 누끼 완료 후 Luma로 미세 모션 루프 영상 생성 (기본 꺼짐 — 과금 발생).
# 켜려면 아래 + backend(.env)에 ENABLE_GENERATE_API=1, LUMA_API_KEY 필요.
# 액션(20종)은 더 이상 Luma가 아니라 Live Portrait가 맡을 예정이라 idle 1건만 생성됨.
# VITE_ENABLE_LUMA=1

# 아이들 API 실패 시 데모 mp4 폴백 (테스트 전용). device.eternalbeam.com 은 env 없이도 자동 ON.
# VITE_IDLE_TEST_FALLBACK=1
# VITE_IDLE_TEST_FALLBACK_URL=https://device.eternalbeam.com/demo/goya_idle_packed.mp4

# --- 백엔드(backend/.env) SAM2+ViTMatte 매팅 파이프라인 ---
# VITMATTE_SEGMENTER=grabcut         # 기본 sam2. SAM2 로드 실패 시에도 자동으로 grabcut 폴백됨
# VITMATTE_SAM2_MODEL=facebook/sam2.1-hiera-small  # 기본 -tiny (가장 가벼움). 품질↑ 원하면 -small/-base-plus/-large
# VITMATTE_MODEL=hustvl/vitmatte-small-composition-1k
# VITMATTE_PRELOAD_MODEL=1           # 서버 기동 시 모델 미리 로드(첫 요청 지연 방지, 메모리 상승)

# 프리미엄 배경 결제 (PayPal). Client ID는 프론트(JS SDK) + 백엔드(주문검증) 둘 다 필요.
# Secret은 절대 프론트에 노출하지 말고 backend(.env)/Render 환경변수에만 넣으세요.
# VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
# PAYPAL_CLIENT_ID=your_paypal_client_id_here   (backend/.env, VITE 것과 동일 값)
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here   (backend/.env, 절대 커밋 금지)
# PAYPAL_MODE=sandbox   # 실결제 전환 시 live

# "내 사진으로 나만의 배경 만들기"(custom_photo_bg, $2.99 — 프리미엄 테마와 동일 티어)
# 배경_인페인팅_파이프라인: SAM2 인페인팅(LaMa) → Luma 배경 애니메이션 → seamless loop.
# 1차 실행 경로: 로컬 RTX 4090 등 GPU 머신에서 `python -m backend.workers.background_video_worker`
# (docs/배경_인페인팅_파이프라인_진행상황.md 참고)
# ENABLE_BACKGROUND_VIDEO_API=1   # FastAPI에 /api/background-video/* 라우트 노출 (기본 ON)
# BACKGROUND_INPAINT_MASK_DILATE_PX=20
# BACKGROUND_VIDEO_TARGET_FPS=24
# BACKGROUND_VIDEO_TARGET_DURATION_SEC=4.0
# BACKGROUND_VIDEO_WORKER_ID=goya-rtx4090-bg
# BACKGROUND_VIDEO_POLL_INTERVAL_SEC=10

# ─────────────────────────────────────────────────────────────────────────────
# QR Shaker (Phase 10) — 로그인 없이 펫 하나를 보는 공개 경험
# ─────────────────────────────────────────────────────────────────────────────
# 경로: /shaker?petId=<PET_ID>&share=<SAFE_TOKEN>
# 공개 API: GET /api/v1/shaker/pet?share=<TOKEN>  (인증 없음, 생성 없음)
#
# ⚠️ 공유 토큰은 서버가 발급하고 **해시만** 저장한다. 원문은 발급 응답 1회에만
#    존재하므로 다시 조회할 수 없다 — 잃어버리면 폐기 후 재발급이 유일한 경로다.
#    필요한 테이블: supabase/migrations/20260820000000_shaker_shares.sql

# 더블탭 상업 정책. **PM 확정: membership (기본값).**
#   membership  (C, 기본) 구독 ACTIVE ∩ 자산 READY ∩ 선호 ON 일 때만 허용.
#                     Phase 6 런타임 적격성(isBehaviorEligible)과 같은 규칙이다 —
#                     소유자가 끈 행동은 QR 로도 재생되지 않는다.
#   disabled    더블탭을 완전히 끈다 (되돌리기용)
#   free        (A) READY 인 액션이면 무조건 허용 (COME_CLOSER 우선)
#   ready-only  (B) COME_CLOSER 가 READY 일 때만 허용
# 알 수 없는 값은 기본값(membership)으로 떨어진다 — 세 조건을 모두 요구하므로 안전하다.
# 세 조건 중 하나라도 **판정 불가**면 거절한다 (구독/선호 조회 장애 = fail closed).
# BREATHING 은 이 설정과 무관하게 언제나 무료로 재생된다.
# SHAKER_DOUBLE_TAP_POLICY=membership

# 해석 시 재발급하는 서명 URL 의 수명(초). 기본 3600.
# 저장된 7일짜리 서명에 의존하지 않는다 — 인쇄된 QR 이 서명보다 오래 살기 때문에
# 매 해석마다 스토리지 객체 경로에서 새로 서명한다.
# 필요한 컬럼: supabase/migrations/20260820000100_shaker_share_object_paths.sql
# SHAKER_SIGNED_URL_TTL_SECONDS=3600

# 공개 엔드포인트 남용 방어 (프로세스 로컬 고정 창, 60초).
# 토큰 추측 방어가 아니다 — 그건 256비트 엔트로피가 한다. 스크래핑·폭주 폴링용이다.
# SHAKER_RATE_LIMIT_ENABLED=1
# SHAKER_PUBLIC_RATE_LIMIT=60

# 공유 테이블명 재정의 (기본 shaker_shares)
# SHAKER_SHARES_TABLE=shaker_shares

# ── QR Shaker: 판매자/운영 QR 워크플로 (Phase 10, 소유 모델 확정) ───────────
# 생산용 QR 은 **판매자(Eternal Beam)가 만든다.** 고객이 만드는 것이 기본 경로가
# 아니다 — 편지·메모리 카드에 인쇄되어 나가는 QR 은 전부 /ops/shaker 에서 나온다.
#
#   고객이 사진 업로드 → canonical petId 생성
#   → 운영이 /ops/shaker 에서 공유 발급 → QR 내려받기
#   → 편지/메모리 카드에 인쇄 → 배송 → 고객이 스캔 → 같은 펫이 열린다

# 운영 콘솔을 쓸 수 있는 Eternal Beam user_id (쉼표 구분).
# **미설정이면 아무도 운영자가 아니다** (fail closed) — 그러면 QR 을 만들 수 없다.
# 공유 시크릿이 아니라 계정 allowlist 인 이유: 인쇄물에 나가는 링크라
# "누가 만들었는가"가 남아야 한다(shaker_shares.created_by).
# SHAKER_OPS_USER_IDS=ops@eternalbeam.com,studio@eternalbeam.com

# QR 에 인코딩할 **웹앱** 베이스 URL. API 도메인이 아니다.
# 미설정이면 요청 호스트에서 유도하는데, 그러면 QR 이 API 도메인을 가리켜
# 아무것도 열리지 않는다. 인쇄된 QR 은 회수할 수 없다 — 반드시 설정할 것.
# PUBLIC_WEB_BASE_URL=https://eternalbeam.com

# 재생 URL 프록시. 기본 켬. 끄면 서명 URL 이 공개 응답에 그대로 실리는데,
# 스토리지 객체 경로가 `{user_id}/{content_id}/…` 이고 user_id 가 **이메일**이라
# 고객 이메일이 노출된다. 되돌리기 스위치이지 권장 설정이 아니다.
# SHAKER_PROXY_ASSET_URLS=1

# 고객이 직접 QR 링크를 만들 수 있게 할 것인가 (프론트 플래그). **기본 꺼짐.**
# 생산 워크플로는 운영이다. 둘 다 열려 있으면 "이 QR 은 누가 만든 것인가"가
# 흐려지고, 고객이 만든 링크가 인쇄물에 섞여 들어갈 수 있다.
# VITE_SHAKER_CUSTOMER_SHARE=0

# ─────────────────────────────────────────────────────────────────────────────
# 유료 테마 스토어 (Phase 11)
# ─────────────────────────────────────────────────────────────────────────────
# 테마 소유권은 **구독 자격과 완전히 별개다.**
#   user_subscriptions       "이번 달 회원인가"  → 만료된다
#   user_theme_entitlements  "이 테마를 샀는가"  → 남는다
# 구독이 끊겨도 산 테마는 남고, 테마를 사도 구독 상태는 바뀌지 않는다.
# 필요한 테이블: supabase/migrations/20260821000000_user_theme_entitlements.sql

# ⚠️ **가격은 코드에 기본값이 없다.** 설정하지 않은 유료 테마는 팔리지 않고
#    카탈로그에 "준비 중"으로 나온다. 0 으로 떨어뜨리지 않는 이유: 그러면
#    가격 미설정이 곧 전량 무료 배포가 된다.
#    (레거시 PayPal USD 가격표 theme_prices.py 는 그대로 남아 있고 별개다.)
# THEME_PRICE_AURORA_KRW=4900
# THEME_PRICE_SUNSET_KRW=4900
# THEME_PRICE_OCEAN_DEEP_KRW=4900
# THEME_PRICE_CUSTOM_PHOTO_BG_KRW=4900

# 어떤 테마가 유료인가. 미설정이면 themes.ts 의 premium 플래그를 따른다
# (aurora / sunset / ocean_deep / custom_photo_bg). PM 이 판매 구성을 바꾸면
# 코드가 아니라 여기서 바꾼다. 빈 문자열 = 전부 무료(되돌리기 스위치).
# THEME_PAID_KEYS=beach,snow_forest,aurora

# 구매한 테마의 유효 기간(일). **미설정 = 영구** (기본).
# ⚠️ PM 미결. 목표 UX 가 "OWNED" 이므로 영구가 기본이고 기간제가 새 발명이다.
# THEME_ENTITLEMENT_TTL_DAYS=

# 소유권 테이블명 재정의
# THEME_ENTITLEMENTS_TABLE=user_theme_entitlements
# THEME_ORDERS_TABLE=theme_purchase_orders

# 테마는 **일회성 결제**다. 카드 등록(구독 체크아웃)을 요구하지 않는다:
#   POST /api/v1/themes/checkout → Toss 결제창 → /themes/success
#   POST /api/v1/themes/confirm  → 서버 검증 → user_theme_entitlements 1행
# 저장된 카드가 있으면 POST /purchase 로 결제창 없이 끝난다(단축키, 선택).
# 필요한 테이블: supabase/migrations/20260821000100_theme_purchase_orders.sql
#
# ⚠️ 결제 승인 금액은 **서버가 보관한 주문**이 기준이다. 리다이렉트 쿼리의 amount 는
#    대조용일 뿐이라, URL 을 고쳐도 싸게 살 수 없다.
# 결제창 SDK 에는 Toss **클라이언트 키**(공개)가 필요하다 — 멤버십과 같은 키를 쓴다.

# ─────────────────────────────────────────────────────────────────────────────
# 물리 제품 주문 (Phase 12) — LETTER / MEMORY BOX
# ─────────────────────────────────────────────────────────────────────────────
# 구독·테마·크레딧과 **완전히 별개인 네 번째 축**이다. 실물을 사도 회원이 되지
# 않고 크레딧도 테마도 생기지 않는다.
# ⚠️ ₩14,900 은 **종이·인쇄·배송 값**이다. BREATHING 은 언제나 무료이며 이
#    주문이 그것을 잠금 해제하지 않는다.
#
# 필요한 테이블:
#   supabase/migrations/20260822000000_soul_trace_letters.sql
#   supabase/migrations/20260822000100_physical_orders.sql
#
# 결제는 Phase 11 과 같은 일회성 Toss 흐름이다 (멤버십/카드 등록 불필요):
#   POST /api/v1/orders/checkout → 결제창 → /orders/success
#   POST /api/v1/orders/confirm  → 서버 검증 → 주문 PAID
#
# 운영 주문 검색은 Phase 10 과 **같은 allowlist** 를 쓴다 (SHAKER_OPS_USER_IDS).

# PM 확정 가격. 인쇄 단가·배송비가 바뀌면 코드 배포 없이 조정한다.
# 오타/음수/0 은 확정 가격으로 떨어진다 — 0원 배송이 되지 않게.
# PRODUCT_PRICE_LETTER_KRW=14900
# PRODUCT_PRICE_MEMORY_BOX_KRW=49000

# 테이블명 재정의
# PHYSICAL_ORDERS_TABLE=physical_orders
# SOUL_TRACE_LETTERS_TABLE=soul_trace_letters

# ⚠️ Soul Trace 는 아직 백엔드가 없다. 편지는 POST /api/v1/orders/letter/link 로
#    **본문과 함께** 들어와야 한다 — Eternal Beam 은 편지를 생성하지 않는다.
#    Soul Trace 가 실제 편지 API 를 갖게 되면 그 경로만 그쪽을 바라보면 된다.

# 결제 재조정 백스톱 (Phase 12 마무리)
#   POST /api/v1/orders/reconcile      로그인 사용자가 앱을 다시 열 때 (자기 것만)
#   POST /api/v1/orders/reconcile-due  크론 스윕 (X-Cron-Secret 필요)
# 결제창 승인 **직후** 브라우저가 닫히면 successUrl 로 돌아오지 못해 주문이 pending
# 으로 남는다 — 돈은 받고 물건은 만들지 않는 상태다. 재조정이 Toss 에 물어 정리한다.
# 새 결제를 만들지 않으며, 금액이 다르면 자동 확정하지 않는다(사람이 확인해야 한다).
# 구독 갱신 배치와 **같은 시크릿**을 쓴다 — 크론 자격을 두 벌 만들지 않는다.
# BILLING_CRON_SECRET=...

# ─────────────────────────────────────────────────────────────────────────────
# 인쇄 생산 파이프라인 (Phase 13)
# ─────────────────────────────────────────────────────────────────────────────
# 필요한 테이블: supabase/migrations/20260823000000_production_packages.sql
# 운영 전용이며 Phase 10 과 **같은 allowlist**(SHAKER_OPS_USER_IDS)를 쓴다.
#
# ⚠️ 한글 폰트: 기본은 reportlab 내장 CID 폰트라 파일 없이도 렌더되지만
#    **PDF 에 임베드되지 않는다.** 프리뷰는 멀쩡한데 인쇄소에서 깨질 수 있다.
#    실제 인쇄 전에 라이선스된 한글 TTF 를 지정해 임베드할 것 (/readiness 가 경고).
# PRINT_LETTER_FONT_PATH=/opt/fonts/NotoSerifKR-Regular.ttf
# PRINT_CARD_FONT_PATH=/opt/fonts/NotoSansKR-Medium.ttf   # 미지정 시 편지 폰트 사용
#
# 생산 패키지는 **파일을 저장하지 않는다** — 입력 스냅샷만 남기고 렌더링은
# 결정적이다(reportlab invariant=1). 같은 주문은 언제 다시 뽑아도 같은 바이트다.
# PRODUCTION_PACKAGES_TABLE=production_packages

# ── 운영 생산 콘솔 + QR 재다운로드 (Phase 13.1) ─────────────────────────────
# 콘솔: /ops/production  (Phase 10 과 같은 SHAKER_OPS_USER_IDS allowlist)
# 필요한 테이블:
#   supabase/migrations/20260824000000_shaker_qr_artifacts.sql
#   supabase/migrations/20260824000100_production_qr_from_artifact.sql
#
# QR 재다운로드: 발급 탭을 닫아도 **같은 QR** 을 다시 받을 수 있다. 토큰은 여전히
# 해시로만 저장되고, 렌더된 산출물(SVG/PNG)만 보관한다. 재다운로드는 새 공유를
# 만들지 않으므로 **이미 인쇄된 QR 이 계속 유효하다**.
# ⚠️ QR 은 디코딩 가능하다 — 산출물을 볼 수 있으면 스캔해 URL 을 얻을 수 있다.
#    보호는 암호가 아니라 운영 allowlist(접근 제어)다.
#
# 인쇄 안전: LETTER/MEMORY_BOX 목적의 QR 은 PUBLIC_WEB_BASE_URL 이 없으면
# **만들지 않는다**(fail closed). http:// 나 localhost 도 거절한다 —
# 인쇄된 QR 은 회수할 수 없다. 화면용(OPS/CUSTOMER)은 예전처럼 폴백한다.
# PUBLIC_WEB_BASE_URL=https://eternalbeam.com
# SHAKER_QR_ARTIFACTS_TABLE=shaker_qr_artifacts

# ── canonical 펫 레지스트리 (Phase 13.2) ────────────────────────────────────
# 필요한 테이블: supabase/migrations/20260825000000_pets_registry.sql
#
# 왜: 예전에는 운영 검색이 generated_motions 를 펫 목록으로 썼는데, 그 테이블은
# **프리미엄 모션이 승격됐을 때만** 채워진다. 무료 BREATHING 펫은 거기 없어서
# 운영 콘솔에 아예 나타나지 않았고 — QR 제품의 주 고객이 생산에 들어올 수 없었다.
#
#   POST /api/v1/pet/registry/register     앱이 BREATHING 완료 후 호출 (멱등)
#   GET  /api/v1/pet/registry/mine         내 펫
#   POST /api/v1/shaker/ops/pets/register  운영 수동 등록·백필 (allowlist 필요)
#
# 등록은 BREATHING 객체가 **실제로 있어야** 성공한다(서명 시도가 존재 확인).
# 서명 URL 이 아니라 만료되지 않는 버킷+경로를 저장한다.
# generated_motions 폴백은 백필이 끝날 때까지의 과도기 조치다.
# PETS_TABLE=pets

# ── Soul Trace 핸드오프 (Phase 10.5) ─────────────────────────────────────────
# Soul Trace 는 **다른 Supabase 프로젝트**다(교차 DB 조회 없음, service-role 키
# 공유 없음). 편지 본문은 아래 자격 증명으로 **서버 대 서버**로만 이동한다 —
# 브라우저는 traceId 와 1회용 불투명 토큰만 나른다.
#
# 백엔드는 Render 에서 돈다: 실제 값은 Render 대시보드에 넣는다(render.yaml).
SOUL_TRACE_API_BASE=https://soultrace.eternalbeam.com
# ⚠️ 백엔드 전용. VITE_ 접두사 금지 — 붙이면 브라우저 번들에 박혀 Soul Trace
#    내부 API 가 누구에게나 열린다. Soul Trace 쪽 값과 **정확히 같아야** 한다.
SOUL_TRACE_SERVICE_TOKEN=
