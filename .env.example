# ⚠️ IMPORTANT: Add this file to .gitignore!
# Do NOT commit this file to version control

# Firebase Configuration (로그인: Console → Authentication → Sign-in method → Email/Password 활성화)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Hugging Face AI API
VITE_HUGGINGFACE_API_KEY=hf_your_real_api_key_here

# Toss Payments (Test Mode)
VITE_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
VITE_TOSS_SECRET_KEY=test_sk_your_secret_key_here

# Toss Payments (Production Mode - Use when deploying)
# VITE_TOSS_CLIENT_KEY=live_ck_your_production_key_here
# VITE_TOSS_SECRET_KEY=live_sk_your_secret_key_here

# Supabase — 프론트·Node·Python이 **같은 프로젝트**를 쓰도록 한 세트로 맞춤 (예전 URL/키가 남아 있으면 전부 교체)
# Dashboard → Settings → API: Project URL = VITE_SUPABASE_URL = SUPABASE_URL (세 곳 모두 동일 문자열)
# anon / publishable 키 → VITE_SUPABASE_ANON_KEY (브라우저). service_role JWT → SUPABASE_SERVICE_ROLE_KEY (서버만, 절대 프론트에 넣지 않음)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_jwt_here

# Vercel 배포: 위 네 줄을 Production/Preview 환경 변수에도 동일하게 추가. Luma 파이프라인은 SUPABASE Storage 공개 URL이 필요함.
# npm run video-api: 루트 .env 를 읽음. backend/.env.local 에 빈 SUPABASE_URL= 만 두면 안 됨(덮어쓰기 방지 로직 적용됨).

# Storage 버킷 (기본 user-assets). 없으면 Dashboard → Storage 에서 생성.
# SUPABASE_STORAGE_BUCKET=user-assets

# --- 영상 생성 프로바이더 선택 (동기 아이들 경로 전용) ---
# luma (기본, 미설정 시에도 luma) = 프로덕션 품질. wan = 개발/테스트용 저가.
# Luma 웹훅/크레딧 비동기 경로(pet_v1.py)는 항상 Luma 를 쓴다 — 이 스위치와 무관.
# VIDEO_PROVIDER=luma

# fal.ai Wan 2.2 A14B Turbo I2V (VIDEO_PROVIDER=wan 일 때만 사용)
# aspect_ratio 기본값을 9:16 으로 못박아 세로 영상을 유지한다(fal 기본 auto 는 가로가 될 수 있음).
# FAL_KEY=your_fal_key_here
# WAN_MODEL=fal-ai/wan/v2.2-a14b/image-to-video/turbo
# WAN_RESOLUTION=480p          # 480p | 580p | 720p
# WAN_ASPECT_RATIO=9:16        # auto | 16:9 | 9:16 | 1:1
# WAN_POLL_MAX_SEC=1200

# Luma Dream Machine API (Image-to-Video) - https://lumalabs.ai/
LUMA_API_KEY=your_luma_api_key_here
# 40-scenario batch: POST /api/v1/pet/generate-all (webhook needs public URL)
PUBLIC_API_BASE_URL=https://your-api.onrender.com
# LUMA_MOCK=1
# MOCK_LUMA_VIDEO_URL=https://example.com/sample.mp4
# PET_BATCH_USE_SUPABASE=1
# Hybrid NFC + credits
# CREDIT_COST_PER_PLACE=4
# LUMA_CREDIT_CONCURRENCY=3
# HYBRID_USE_SUPABASE=1
# PET_HYBRID_SEED=1
# STARTER_CREDITS=4
# Vercel: 크레딧+Luma (배경 선택 시 4종 영상 요청)
# VITE_ENABLE_CREDITS=1
# VITE_CREDIT_COST_PER_PLACE=4

# --- 테스트 앱 (목업) — .env.test.example 참고 ---
# VITE_MOCK_CUTOUT=1
# 누끼: 기본은 Render 서버만(30초~2분). 폰 폴백(1~3분+)은 아래를 1로
# VITE_CLIENT_CUTOUT_FALLBACK=1
# VITE_CLIENT_CUTOUT=1
# 누끼 속도 우선 (기본 ON). 품질·장모 2차 매팅: VITE_CUTOUT_SPEED_MODE=0
# VITE_CUTOUT_SPEED_MODE=1
# 누끼 후 홀로그램 데모 대기(초). 0이면 누끼 직후 바로 다음 화면
# VITE_FILM_CONVERSION_SEC=0
# VITE_IAP_MOCK=1
# VITE_TEST_APP=1
# backend/env.local.example → PAYMENT_MOCK=1, HYBRID_USE_SUPABASE=0

# 구독 (Standard · 월 9900원 · +12 크레딧/월) — docs/SUBSCRIPTION.md
# SUBSCRIPTION_MOCK=1
# SUBSCRIPTION_GATE_DEVICE=0

# Stripe (크레딧 팩 충전 — fiat → credits_wallet)
# Dashboard → Developers → API keys / Webhooks (checkout.session.completed → POST /api/v1/stripe/webhook)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# IAP (인앱 결제 검증)
# PAYMENT_MOCK=1
# APPLE_SHARED_SECRET=
# APPLE_USE_SANDBOX=1
# GOOGLE_PACKAGE_NAME=com.eternalbeam.app
# GOOGLE_VERIFY_URL=

# Modal GPU (배경 제거 15초 내 처리) - modal.com
# modal token new 로 발급 후 설정. 없으면 로컬 CPU 사용
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
# MODAL_GPU=T4  # 또는 A10G (배포 시 Modal Secret으로 설정 가능)

# 적응형 누끼 (fast → 알파 분석 → 장모 시 matting 재처리, Render 백엔드)
# CUTOUT_ADAPTIVE_REFINE=true

# LivePortrait 액션 20종 파이프라인 (docs/LivePortrait_설치_가이드.md 참고)
# 1차 실행 경로: 로컬 RTX 4090 등 GPU 머신에서 `python -m backend.workers.live_portrait_worker`
# ENABLE_LIVE_PORTRAIT_API=1   # FastAPI에 /api/live-portrait/* 라우트 노출 (기본 ON)
# LIVE_PORTRAIT_REPO_DIR=/path/to/LivePortrait
# LIVE_PORTRAIT_PYTHON=/path/to/LivePortrait/venv/bin/python
# LIVE_PORTRAIT_DRIVING_VIDEOS_DIR=backend/assets/driving_videos
# LIVE_PORTRAIT_DRIVING_MULTIPLIER=1.75
# LIVE_PORTRAIT_WORKER_ID=goya-rtx4090
# LIVE_PORTRAIT_POLL_INTERVAL_SEC=10
# LIVE_PORTRAIT_STALE_MINUTES=30
# LIVE_PORTRAIT_SAM2_KEYFRAME_INTERVAL=10
# CUTOUT_FUR_EDGE_RATIO_THRESHOLD=0.38

# 포레스트 체험 화면 (청량한 숲속 테마 → forestExperience)
# 공개 URL: https://device.eternalbeam.com/forest
# 배경 교체: public/demo/forest.mp4 덮어쓰기. URL로 바꿀 때만 아래 사용.
# VITE_FOREST_BG_URL=/demo/forest.mp4
# VITE_FOREST_IDLE_URL=/demo/goya_idle_packed.mp4
# VITE_FOREST_ACTION_URL=/demo/goya_touch_packed.mp4

# App Environment
VITE_APP_ENV=development

# Pi 센서 브리지 (기기 데모 촬영) — Android는 eternalbeam.local 이 안 될 수 있음
# URL로 직접: https://device.eternalbeam.com/?demo=device&pi=192.168.0.100
# VITE_PI_HTTP_BASE=http://192.168.0.100:8787
# VITE_PI_HOST=192.168.0.100
# VITE_PI_HOSTS=192.168.0.100,192.168.0.101,eternalbeam.local

# 조정 화면 Luma/FFmpeg 개발 패널 (프로덕션에서만 켜려면 1)
# VITE_SHOW_PIPELINE_DEBUG=1

# 누끼/합성 API (프로덕션 필수). trycloudflare/ngrok 임시 URL은 쓰지 마세요(만료됨).
# 예: https://eternal-beam-video-api.onrender.com
# 비우면 device.eternalbeam.com/api → vercel.json 프록시 사용
# VITE_VIDEO_API_URL=https://eternal-beam-video-api.onrender.com

# 누끼 파이프라인: 기본은 SAM2+ViTMatte(/api/matting/cutout). 문제 생기면 rembg로 즉시 롤백.
# VITE_CUTOUT_PIPELINE=rembg

# 아이들(Idle) 섹션: 누끼 완료 후 Luma로 미세 모션 루프 영상 생성 (기본 꺼짐 — 과금 발생).
# 켜려면 아래 + backend(.env)에 ENABLE_GENERATE_API=1, LUMA_API_KEY 필요.
# 액션(20종)은 더 이상 Luma가 아니라 Live Portrait가 맡을 예정이라 idle 1건만 생성됨.
# VITE_ENABLE_LUMA=1

# 아이들 API 실패 시 데모 mp4 폴백 (테스트 전용). device.eternalbeam.com 은 env 없이도 자동 ON.
# VITE_IDLE_TEST_FALLBACK=1
# VITE_IDLE_TEST_FALLBACK_URL=https://device.eternalbeam.com/demo/goya_idle_packed.mp4

# --- 백엔드(backend/.env) SAM2+ViTMatte 매팅 파이프라인 ---
# VITMATTE_SEGMENTER=grabcut         # 기본 sam2. SAM2 로드 실패 시에도 자동으로 grabcut 폴백됨
# VITMATTE_SAM2_MODEL=facebook/sam2.1-hiera-small  # 기본 -tiny (가장 가벼움). 품질↑ 원하면 -small/-base-plus/-large
# VITMATTE_MODEL=hustvl/vitmatte-small-composition-1k
# VITMATTE_PRELOAD_MODEL=1           # 서버 기동 시 모델 미리 로드(첫 요청 지연 방지, 메모리 상승)

# 프리미엄 배경 결제 (PayPal). Client ID는 프론트(JS SDK) + 백엔드(주문검증) 둘 다 필요.
# Secret은 절대 프론트에 노출하지 말고 backend(.env)/Render 환경변수에만 넣으세요.
# VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
# PAYPAL_CLIENT_ID=your_paypal_client_id_here   (backend/.env, VITE 것과 동일 값)
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here   (backend/.env, 절대 커밋 금지)
# PAYPAL_MODE=sandbox   # 실결제 전환 시 live

# "내 사진으로 나만의 배경 만들기"(custom_photo_bg, $2.99 — 프리미엄 테마와 동일 티어)
# 배경_인페인팅_파이프라인: SAM2 인페인팅(LaMa) → Luma 배경 애니메이션 → seamless loop.
# 1차 실행 경로: 로컬 RTX 4090 등 GPU 머신에서 `python -m backend.workers.background_video_worker`
# (docs/배경_인페인팅_파이프라인_진행상황.md 참고)
# ENABLE_BACKGROUND_VIDEO_API=1   # FastAPI에 /api/background-video/* 라우트 노출 (기본 ON)
# BACKGROUND_INPAINT_MASK_DILATE_PX=20
# BACKGROUND_VIDEO_TARGET_FPS=24
# BACKGROUND_VIDEO_TARGET_DURATION_SEC=4.0
# BACKGROUND_VIDEO_WORKER_ID=goya-rtx4090-bg
# BACKGROUND_VIDEO_POLL_INTERVAL_SEC=10
