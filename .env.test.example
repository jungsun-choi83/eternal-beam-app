# 테스트 앱용 — .env.local 로 복사 (git 제외)
# copy .env.test.example .env.local

# 빠른 플로우: AI 누끼 생략 (원본 리사이즈만)
VITE_MOCK_CUTOUT=1

# IAP 목업 결제 (credit_pack_4 · 백엔드 PAYMENT_MOCK=1 필요)
VITE_IAP_MOCK=1
# 구독 목업 (설정 → 구독 테스트 · Render SUBSCRIPTION_MOCK=1)
VITE_SUBSCRIPTION_MOCK=1
VITE_ENABLE_CREDITS=1
VITE_CREDIT_COST_PER_PLACE=4

# 온보딩 건너뛰기
VITE_FILM_SKIP_ONBOARDING=1

# 로컬 백엔드 (npm run video-api)
# VITE_VIDEO_API_URL=
