# Eternal Beam Pi 환경설정 — install.sh 가 eternal-beam-pi.env 로 복사/치환한다.
# Unity(기계 속 폰)의 Wi-Fi IP 로 바꾸세요. (예: 192.168.0.25)
UDP_HOST=192.168.0.25
UDP_PORT=5005

# NFC UID -> 테마 매핑 파일 (절대경로 권장)
# NFC_THEME_MAP=/home/pi/eternal-beam-app/python/nfc_theme_map.json

# 마이크 감도 (조용한 환경이면 낮추고, 시끄러우면 올리세요)
VOICE_RMS_THRESHOLD=1200
VOICE_RATE=48000
VOICE_CHANNELS=2
