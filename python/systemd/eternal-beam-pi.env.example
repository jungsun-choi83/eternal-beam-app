# Eternal Beam — 2디스플레이 (배경=터치스크린, 피사체=기계 안 폰 Unity)
# install.sh 가 eternal-beam-pi.env 로 복사합니다.

# 보드 선택 (기본은 hardware_config.yaml 의 active_board) — RK3566이면 주석 해제:
# HARDWARE_BOARD=rk3566

# Unity 폰(S23) Wi-Fi IP — touch/voice/approach 만 (피사체)
UDP_HOST=192.168.219.187
UDP_PORT=5005

# Pi 터치스크린 배경 — NFC nfc_tagged 만 (pi_display_bg.py)
BG_DISPLAY_HOST=127.0.0.1
BG_DISPLAY_PORT=9999

# 흰 NFC 카드 UID 미등록 시에도 숲 배경
NFC_FALLBACK_THEME=forest

# NFC_THEME_MAP=/home/pi/eternal-beam/python/nfc_theme_map.json

VOICE_RMS_THRESHOLD=1200
VOICE_RATE=48000
VOICE_CHANNELS=2
