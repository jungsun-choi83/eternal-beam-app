# 로컬 테스트 앱용 — backend/env.local 로 복사
# cp env.local.example env.local  (Windows: copy env.local.example env.local)

# Supabase 없이 메모리 지갑·결제 이력 (로컬 목업)
HYBRID_USE_SUPABASE=0
PET_HYBRID_SEED=1
STARTER_CREDITS=4

# IAP: 스토어 API 없이 영수증 8자 이상이면 통과
PAYMENT_MOCK=1

# 구독 웹훅 목업 (JSON 바디로 INITIAL_BUY / RENEWAL / EXPIRATION 테스트)
SUBSCRIPTION_MOCK=1
# Unity device/sync 구독 없으면 403 (운영 시 1)
# SUBSCRIPTION_GATE_DEVICE=0

# 크레딧 1회 배경 생성 비용
CREDIT_COST_PER_PLACE=4

# Luma·generate 라우터는 끔 (누끼·결제만 테스트)
ENABLE_GENERATE_API=0
