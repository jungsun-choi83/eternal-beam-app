# 로컬 테스트 앱용 — backend/env.local 로 복사
# cp env.local.example env.local  (Windows: copy env.local.example env.local)

# Supabase 없이 메모리 지갑·결제 이력 (로컬 목업)
HYBRID_USE_SUPABASE=0
PET_HYBRID_SEED=1
STARTER_CREDITS=4

# IAP: 스토어 API 없이 영수증 8자 이상이면 통과
PAYMENT_MOCK=1

# 구독 웹훅 목업 (JSON 바디로 INITIAL_BUY / RENEWAL / EXPIRATION 테스트)
SUBSCRIPTION_MOCK=1
# Unity device/sync 구독 없으면 403 (운영 시 1)
# SUBSCRIPTION_GATE_DEVICE=0

# 크레딧 1회 배경 생성 비용
CREDIT_COST_PER_PLACE=4

# Luma·generate 라우터는 끔 (누끼·결제만 테스트)
ENABLE_GENERATE_API=0

# --- 아이들(Idle) 섹션 테스트: 위 줄을 1로 바꾸고 아래도 설정 ---
# 프론트: .env 에 VITE_ENABLE_LUMA=1 도 같이 필요 (기본 꺼짐, 실제 Luma 과금 발생)
# ENABLE_GENERATE_API=1
# LUMA_API_KEY=luma-...
# 돈 안 쓰고 파이프라인만(업로드→루프→저장) 확인하려면:
# LUMA_MOCK=1 — MOCK_LUMA_USE_KEYFRAME=1(기본)이면 Goya 데모 대신 사용자 keyframe mp4 생성
# MOCK_LUMA_USE_KEYFRAME=0 — 예전처럼 MOCK_LUMA_VIDEO_URL(Goya 데모) 사용
# MOCK_LUMA_KEYFRAME_SEC=3

# 아이들 5종 세트(POST /api/generate-idle-variant, VideoGenerationService.ts)의
# "블랙 배경 판정" 임계값(0~255, 낮을수록 엄격). ffmpeg로 첫 프레임 모서리 밝기 측정.
# LUMA_IDLE_BLACK_BG_THRESHOLD=42

# --- 프리미엄 배경 결제 (PayPal Orders v2) ---
# PayPal Developer Dashboard(sandbox app)에서 발급. 프론트 .env 의 VITE_PAYPAL_CLIENT_ID
# 와 PAYPAL_CLIENT_ID는 반드시 같은 값이어야 함(같은 앱). Secret은 여기(backend)에만.
# PAYPAL_CLIENT_ID=your_sandbox_client_id
# PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
# PAYPAL_MODE=sandbox

# --- "내 사진으로 나만의 배경 만들기"(custom_photo_bg) 파이프라인 ---
# 로컬 RTX 4090 등 GPU 머신에서 `python -m backend.workers.background_video_worker`.
# SAM2 인페인팅+Luma+seamless loop 전부 그 워커 프로세스 안에서 돈다(Render에는 안 돌림).
# ENABLE_BACKGROUND_VIDEO_API=1   # FastAPI에 /api/background-video/* 라우트 노출(기본 ON)
# BACKGROUND_INPAINT_SEGMENTER=grabcut       # 기본 sam2. 실패 시 자동 grabcut 폴백
# BACKGROUND_INPAINT_MASK_DILATE_PX=20
# BACKGROUND_VIDEO_TARGET_FPS=24
# BACKGROUND_VIDEO_TARGET_DURATION_SEC=4.0
# BACKGROUND_VIDEO_WORKER_ID=goya-rtx4090-bg
# BACKGROUND_VIDEO_POLL_INTERVAL_SEC=10
# BACKGROUND_VIDEO_STALE_MINUTES=30
