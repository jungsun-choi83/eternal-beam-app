{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://eternal-beam-video-api.onrender.com/api/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "https://eternal-beam-video-api.onrender.com/outputs/:path*"
    },
    {
      "source": "/output/:path*",
      "destination": "https://eternal-beam-video-api.onrender.com/output/:path*"
    },
    {
      "source": "/((?!api/|outputs/|output/|assets/|demo/).*)",
      "destination": "/index.html"
    }
  ]
}
