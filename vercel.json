{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://eternal-beam-video-api.onrender.com/api/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "https://eternal-beam-video-api.onrender.com/outputs/:path*"
    },
    {
      "source": "/output/:path*",
      "destination": "https://eternal-beam-video-api.onrender.com/output/:path*"
    }
  ]
}
